# Build / output folders
# =============================================================================
output/
exports/
_build/
dist/

# =============================================================================
# LPT Review source folders — ignored entirely so VS Code stays quiet.
# Only .md files (converted text) are allowed through.
# =============================================================================
VEA LET COMPILATIONS/**
!VEA LET COMPILATIONS/**/
!VEA LET COMPILATIONS/**/*.md
unorganized/**
!unorganized/**/
!unorganized/**/*.md
